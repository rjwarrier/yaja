        <!-- Quick Capture Activity (Transparent full screen to host the Jetpack Compose Dialog) -->
        <!-- Not exported: only launched via PendingIntent from the widget (same app) or via
             app shortcuts (the system launches static shortcuts with the app's own identity).
             Separate task affinity: shortcut launches force NEW_TASK|CLEAR_TASK, which would
             otherwise wipe the main app task to show this dialog. -->
        <activity
            android:name=".ui.screens.QuickCaptureActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
