        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Journal"
        tools:targetApi="31">
        <!-- No LAUNCHER category here: the visible home-screen icon comes from the
             MainActivityAlias* entries below (lets the user pick an alternate app
             icon). MainActivity itself stays permanently enabled so widgets, the
             "Today" shortcut, and Tasker can keep addressing it directly by class. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Journal"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

