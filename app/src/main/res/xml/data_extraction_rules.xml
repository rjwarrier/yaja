<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
            Cloud backup: only lightweight settings and People & Places definitions.
            Journal files, generated backup ZIPs, caches, and version-history snapshots are excluded
            from silent cloud backup. Use Yaja's explicit Backup action for portable journal copies.
        -->
        <include
            domain="sharedpref"
            path="journal_settings.xml" />
        <include
            domain="sharedpref"
            path="keyword_prefs.xml" />
    </cloud-backup>

    <device-transfer>
        <!--
            Device-to-device transfers: move real internal journal files and core settings,
            but skip generated caches, exported backup ZIPs, and no-backup version history.
        -->
        <include
            domain="sharedpref"
            path="journal_settings.xml" />
        <include
            domain="sharedpref"
            path="keyword_prefs.xml" />
        <include
            domain="file"
            path="journals/" />
    </device-transfer>
</data-extraction-rules>
