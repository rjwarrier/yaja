<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
            Cloud backup: only lightweight settings.
            Journal files, generated backup ZIPs, caches, and version-history snapshots are excluded
            from silent cloud backup. Use Yaja's explicit Backup action for portable journal copies,
            People & Places definitions, and recurring tasks.
        -->
        <include
            domain="sharedpref"
            path="journal_settings.xml" />
        <include
            domain="sharedpref"
            path="keyword_prefs.xml" />
    </cloud-backup>

    <device-transfer>
        <!--
            Device-to-device transfers: move real internal journal files, core settings, and the
            Room database that owns People & Places definitions and recurring tasks. Generated
            backup ZIPs and no-backup version history remain excluded.
        -->
        <include
            domain="sharedpref"
            path="journal_settings.xml" />
        <include
            domain="sharedpref"
            path="keyword_prefs.xml" />
        <include
            domain="file"
            path="journals/" />
        <include
            domain="database"
            path="journal_database" />
        <include
            domain="database"
            path="journal_database-wal" />
        <include
            domain="database"
            path="journal_database-shm" />
    </device-transfer>
</data-extraction-rules>
